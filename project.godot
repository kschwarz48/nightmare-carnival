; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nightmare Carnival"
config/description="A survivors-like roguelite set in a haunted midnight carnival."
run/main_scene="res://scenes/main/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

CollisionLayers="*res://scripts/autoload/collision_layers.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
MapBounds="*res://scripts/autoload/map_bounds.gd"
ContentDB="*res://scripts/autoload/content_db.gd"
ObjectPool="*res://scripts/autoload/object_pool.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
EnemyDirector="*res://scripts/autoload/enemy_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

