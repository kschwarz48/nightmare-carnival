{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--host",
        "127.0.0.1"
      ],
      "port": 4173
    },
    {
      "name": "web-bench",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "exec",
        "--",
        "vite",
        "preview",
        "web",
        "--outDir",
        "dist-bench",
        "--port",
        "4174",
        "--host",
        "127.0.0.1",
        "--strictPort"
      ],
      "port": 4174
    }
  ]
}
